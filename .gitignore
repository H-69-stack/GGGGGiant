/issued/
# 客户现场的许可证文件与机器码
license/license.dat
**/license.dat
# PyInstaller / 打包产物
dist/
build/license_tool/

# 离线 Docker 镜像（由 deploy/export_images.sh 生成，体积大，随安装包分发而非入库）
deploy/images/*.tar
deploy/images/*.tar.gz
deploy/images/MANIFEST.txt

# 站点授权证书（可在任意机器解锁，等同主密钥，严禁入库）
deploy/windows/offline/site_license.dat

